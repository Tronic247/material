		"@storybook/html-vite": "^8.1.11",
		"@storybook/test": "^8.1.11",
		"chokidar": "^3.5.3",
		"chromatic": "^11.5.4",
		"css-minify": "^2.0.0",
		"esbuild": "^0.19.0",
